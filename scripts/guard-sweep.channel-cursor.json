      "guard": "CURSOR_PATTERN",
      "axis": "wider",
      "file": "apps/server/src/mcp/toolkits/comms/tools.ts",
      "find": "export const CURSOR_PATTERN = /^[A-Za-z0-9_-]{1,64}:(?:(?:forward|backward):)?[0-9]{1,15}$/;",
      "replace": "export const CURSOR_PATTERN = /^[A-Za-z0-9_-]{1,64}:(?:forward|backward):[0-9]{1,15}$/;"
